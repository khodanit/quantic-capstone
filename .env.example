# Copy to .env and fill in. Never commit .env.

# Which provider the LLM client uses: anthropic or openai
LLM_PROVIDER=anthropic

# Set the key for your chosen provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Flask session signing key (use a long random string)
SECRET_KEY=change-me

# Where generated tenant databases are stored
DATA_DIR=data
